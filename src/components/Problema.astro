---
// Tres síntomas que conviven, no tres pasos. Por eso no van numerados:
// numerarlos inventaría un orden que no existe.
//
// Sin explicación debajo: el que se reconoce lo hace con el título solo,
// y al que no le pasa no lo va a convencer un párrafo.
const bloques = [
  'Publican sin saber si sirve',
  'No tienen qué grabar',
  'No saben qué está funcionando',
];
---

<section class="seccion lavanda problema">
  <div class="contenedor">
    <p class="etiqueta" data-revelar>El diagnóstico</p>

    <h2 class="titulo" data-revelar style="--retraso: 80ms">
      Lo que vemos<br />todos los días
    </h2>

    <p class="cuerpo intro" data-revelar style="--retraso: 140ms">
      Trabajamos con marcas de todo tipo, y casi todas llegan con el mismo
      cuadro.
    </p>

    <div class="grilla">
      {
        bloques.map((b, i) => (
          <article class="bloque" data-revelar style={`--retraso: ${i * 110}ms`}>
            <h3>{b}</h3>
          </article>
        ))
      }
    </div>

    <p class="remate" data-revelar>
      Si algo de esto te suena, no es porque hiciste las cosas mal.
      <span class="destacado">Es porque estabas haciendo dos trabajos a la vez.</span>
    </p>
  </div>
</section>

<style>
  .problema h2 {
    margin-bottom: clamp(1.2rem, 3vw, 1.6rem);
  }

  .etiqueta {
    margin-bottom: clamp(1.2rem, 3vw, 1.8rem);
  }

  .intro {
    max-width: 44ch;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .grilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1.4rem clamp(1.5rem, 3.5vw, 2.5rem);
    margin-bottom: clamp(2.5rem, 6vw, 3.5rem);
  }

  /* Marca corta en lugar de regla al ancho: la regla larga abría un
     hueco vertical que no aportaba nada */
  .bloque {
    padding-top: 0.9rem;
    border-top: 2px solid var(--acento);
  }

  /* El peso lo carga el título, no un adorno numérico */
  .bloque h3 {
    font-size: clamp(1.3rem, 3vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--violeta-900);
    text-wrap: balance;
  }

  .remate {
    font-size: clamp(1.35rem, 3.8vw, 2.3rem);
    font-weight: 200;
    line-height: 1.3;
    letter-spacing: -0.025em;
    max-width: 24ch;
    color: var(--violeta-900);
    text-wrap: balance;
  }

  .destacado {
    display: block;
    font-weight: 600;
    color: var(--acento);
    margin-top: 0.35em;
  }
</style>
