---
const declaraciones = [
  {
    frase: 'Te decimos lo que pensamos.',
    apoyo:
      'Aunque no sea lo que querías escuchar. Si tu negocio necesita resolver otra cosa antes que las redes, te lo vamos a decir.',
  },
  {
    frase: 'No prometemos ventas en 30 días.',
    apoyo: 'Preferimos darte plazos reales y cumplirlos.',
  },
  {
    frase: 'Todo lo que hacemos te lo explicamos.',
    apoyo: 'Vas a entender siempre por qué publicamos lo que publicamos.',
  },
];
---

<section class="seccion oscura manifiesto">
  <div class="contenedor">
    <p class="etiqueta" data-revelar>Cómo somos para trabajar</p>

    <div class="lista">
      {
        declaraciones.map((d, i) => (
          <div class="declaracion" data-revelar style={`--retraso: ${i * 110}ms`}>
            <p class="frase">{d.frase}</p>
            <p class="cuerpo apoyo">{d.apoyo}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .manifiesto .etiqueta {
    margin-bottom: clamp(2.5rem, 6vw, 3.5rem);
  }

  .declaracion {
    display: grid;
    gap: 0.9rem;
    padding-block: clamp(1.8rem, 4vw, 2.6rem);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .declaracion:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .frase {
    font-size: clamp(1.5rem, 4.2vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.12;
    max-width: 18ch;
  }

  .apoyo {
    max-width: 42ch;
  }

  @media (min-width: 860px) {
    .declaracion {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }

    .apoyo {
      padding-top: 0.6em;
    }
  }
</style>
