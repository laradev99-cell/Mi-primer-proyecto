---
import { whatsapp } from '../data/site.js';

const servicios = [
  {
    titulo: 'Análisis y estrategia',
    texto:
      'Entendemos tu marca, tu público y tu competencia. De ahí sale el plan que guía todo el trabajo.',
    span: 'ancho-2',
    consulta: 'Hola Lara, quiero saber más sobre el análisis y la estrategia.',
  },
  {
    titulo: 'Manejo de redes sociales',
    texto:
      'Ideas, diseño, edición, textos y publicación. Contenido constante en Instagram y Facebook, con reporte mensual.',
    span: 'ancho-4 destacada',
    consulta: 'Hola Lara, quiero saber más sobre el manejo de redes.',
  },
  {
    titulo: 'Tienda online',
    texto:
      'Armamos tu tienda en Tienda Nube o Shopify, o mejoramos la que ya tenés.',
    span: 'ancho-2',
    consulta: 'Hola Lara, quiero saber más sobre las tiendas online.',
  },
  {
    titulo: 'Desarrollo a medida',
    texto:
      'Webs, tiendas y sistemas programados desde cero, con código propio. Sin plantillas y sin los límites de una plataforma.',
    span: 'ancho-2',
    consulta: 'Hola Lara, quiero saber más sobre el desarrollo a medida.',
  },
  {
    titulo: 'Respuestas automáticas con IA',
    texto:
      'Un asistente que conoce tu negocio y responde precios, stock y envíos en Instagram y WhatsApp las 24 horas.',
    span: 'ancho-2',
    consulta: 'Hola Lara, quiero saber más sobre las respuestas con IA.',
  },
];
---

<section class="seccion clara servicios">
  <div class="contenedor">
    <div class="encabezado">
      <p class="etiqueta" data-revelar>Servicios</p>
      <h2 class="titulo" data-revelar style="--retraso: 80ms">Qué hacemos</h2>
    </div>

    <div class="bento">
      {
        servicios.map((s, i) => (
          <a
            class={`tarjeta ${s.span}`}
            href={whatsapp(s.consulta)}
            target="_blank"
            rel="noopener noreferrer"
            data-revelar
            style={`--retraso: ${i * 80}ms`}
          >
            <h3 class="subtitulo">{s.titulo}</h3>
            <p class="cuerpo">{s.texto}</p>
            <span class="consultar">
              Consultar
              <svg class="flecha" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2 8h11m0 0-4.2-4.2M13 8l-4.2 4.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .encabezado {
    margin-bottom: clamp(2.75rem, 7vw, 4rem);
  }

  .encabezado .etiqueta {
    margin-bottom: 1.2rem;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.85rem, 2vw, 1.15rem);
  }

  .tarjeta {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    padding: clamp(1.6rem, 4vw, 2.4rem);
    border-radius: var(--radio);
    background: var(--violeta-100);
    color: var(--violeta-900);
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform var(--transicion), border-color var(--transicion),
      background-color var(--transicion), box-shadow var(--transicion);
  }

  .tarjeta h3 {
    margin-bottom: 0.75rem;
    max-width: 18ch;
  }

  .tarjeta .cuerpo {
    flex: 1;
    margin-bottom: clamp(1.6rem, 4vw, 2.2rem);
  }

  .consultar {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--violeta-600);
  }

  .tarjeta:hover {
    transform: translateY(-5px);
    border-color: var(--violeta-200);
    box-shadow: 0 22px 50px -30px rgba(45, 10, 107, 0.55);
  }

  .tarjeta:hover .flecha {
    transform: translateX(5px);
  }

  .flecha {
    transition: transform var(--transicion);
  }

  /* La tarjeta destacada es la única en oscuro: ancla la grilla */
  .destacada {
    background: var(--tinta);
    color: var(--blanco);
  }

  .destacada h3 {
    color: var(--blanco);
  }

  .destacada .cuerpo {
    color: var(--texto-claro);
  }

  .destacada .consultar {
    color: var(--acento);
  }

  .destacada:hover {
    border-color: rgba(255, 46, 136, 0.5);
  }

  @media (min-width: 760px) {
    .bento {
      grid-template-columns: repeat(6, 1fr);
    }

    .ancho-2 {
      grid-column: span 2;
    }

    .ancho-4 {
      grid-column: span 4;
    }

    .destacada h3 {
      font-size: clamp(1.5rem, 2.8vw, 2rem);
      max-width: 14ch;
    }
  }
</style>
