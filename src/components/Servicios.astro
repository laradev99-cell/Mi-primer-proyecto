---
import { whatsapp } from '../data/site.js';

// El foco de esta página es el manejo de redes. El análisis arranca el
// servicio, el contenido es el ciclo mensual y el vendedor 24 horas se
// le suma aparte. Los tres grupos existen porque son tres momentos
// distintos, no un listado suelto.
const arranque = {
  titulo: 'Análisis y estrategia',
  texto:
    'Entendemos tu marca, tu público y tu competencia. De ahí sale el plan que guía todo el trabajo.',
};

const mensual = [
  'Ideas y plan de contenido',
  'Diseño y edición de cada pieza',
  'Textos escritos para vender',
  'Publicación en Instagram y Facebook',
  'Te decimos qué grabar',
  'Reporte y reunión mensual',
];

// Dos agregados: uno se resuelve acá mismo, el otro abre la sección
// que sigue. Por eso el segundo se escribe como pie, no como cierre.
const extras = [
  {
    titulo: 'El vendedor que nunca duerme',
    texto:
      'Contesta precios, stock y envíos en Instagram y WhatsApp las 24 horas, con el mismo tono que usarías vos.',
  },
  {
    titulo: 'Páginas web',
    texto:
      'Si además necesitás dónde vender, lo programamos nosotros. Te lo contamos acá abajo.',
  },
];

const webs = [
  {
    titulo: 'Tienda sobre plataforma',
    texto:
      'Armamos tu tienda en Tienda Nube o Shopify, o mejoramos la que ya tenés. Para salir a vender rápido, sobre algo probado.',
  },
  {
    titulo: 'Desarrollo a medida',
    texto:
      'Programada desde cero, con código propio. El diseño no depende de una plantilla y el código queda a tu nombre.',
  },
];
---

<section class="seccion clara servicios">
  <div class="contenedor">
    <div class="encabezado">
      <p class="etiqueta" data-revelar>Servicios</p>
      <h2 class="titulo" data-revelar style="--retraso: 80ms">Qué hacemos</h2>
    </div>

    <!-- El servicio central -->
    <article class="principal" data-revelar>
      <div class="principal-intro">
        <h3 class="principal-titulo">Manejo de redes sociales</h3>
        <p class="cuerpo">
          Nos hacemos cargo de tu Instagram y tu Facebook enteros: qué se dice,
          cómo se ve y cuándo sale.
        </p>
      </div>

      <div class="principal-detalle">
        <div class="grupo">
          <p class="grupo-titulo">Arranca con</p>
          <p class="grupo-destacado">{arranque.titulo}</p>
          <p class="grupo-texto">{arranque.texto}</p>
        </div>

        <div class="grupo">
          <p class="grupo-titulo">Todos los meses</p>
          <ul class="items">
            {mensual.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        {
          extras.map((e) => (
            <div class="grupo">
              <p class="grupo-titulo">Se le puede sumar</p>
              <p class="grupo-destacado">{e.titulo}</p>
              <p class="grupo-texto">{e.texto}</p>
            </div>
          ))
        }
      </div>

      <!-- El botón cierra la tarjeta: se llega a él después de leer todo -->
      <div class="principal-pie">
        <a
          class="boton boton-acento"
          href={whatsapp('Hola Lara, quiero saber más sobre el manejo de redes.')}
          target="_blank"
          rel="noopener noreferrer"
        >
          Consultar
          <svg class="flecha" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 8h11m0 0-4.2-4.2M13 8l-4.2 4.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </article>

    <!-- El servicio que se le agrega -->
    <div class="webs">
      <p class="etiqueta" data-revelar>Y si además necesitás web</p>
      <h3 class="webs-titulo" data-revelar style="--retraso: 70ms">
        Páginas web, por dos caminos
      </h3>

      <div class="webs-grilla">
        {
          webs.map((w, i) => (
            <div class="web" data-revelar style={`--retraso: ${i * 100}ms`}>
              <h4>{w.titulo}</h4>
              <p class="cuerpo">{w.texto}</p>
            </div>
          ))
        }
      </div>

      <!-- Las webs tienen su propia página: acá solo se abre la puerta -->
      <div class="webs-pie" data-revelar>
        <a class="boton boton-linea-oscura" href="/webs">
          Ver todo lo de páginas web
          <svg class="flecha" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 8h11m0 0-4.2-4.2M13 8l-4.2 4.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <p class="webs-nota">Precios, tiempos y todo lo que programamos.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .encabezado {
    margin-bottom: clamp(2.5rem, 6vw, 3.5rem);
  }

  .encabezado .etiqueta {
    margin-bottom: 1.2rem;
  }

  /* ── El servicio central ── */
  .principal {
    background: var(--tinta);
    color: var(--blanco);
    border-radius: var(--radio);
    padding: clamp(2rem, 5vw, 3.5rem);
    display: grid;
    /* 60px: la bajada tiene que despegarse del primer bloque */
    gap: 3.75rem;
    margin-bottom: clamp(4rem, 10vw, 6.5rem);
  }

  .principal-titulo {
    font-size: clamp(1.7rem, 4.5vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-bottom: 2.5rem;
    text-wrap: balance;
  }

  .principal .cuerpo {
    color: var(--texto-claro);
    max-width: 32ch;
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .principal-pie {
    padding-top: 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  /* Dentro de la tarjeta oscura el botón vuelve al violeta claro */
  .principal .boton-acento {
    background: #a87cff;
    color: var(--tinta);
  }

  .principal .boton-acento:hover {
    background: #bd9bff;
  }

  /* 50px entre bloques: cada grupo tiene que leerse como una unidad
     aparte, no como párrafos de una misma lista */
  .principal-detalle {
    display: grid;
    gap: 3.125rem;
  }

  .grupo {
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  /* Versaleta en todos: marca momento o contenido especial */
  .grupo-titulo {
    font-size: 0.95rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(217, 199, 255, 0.72);
    margin-bottom: 1.4rem;
  }

  .grupo-destacado {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    text-transform: none;
    color: var(--blanco);
    margin-bottom: 0.8rem;
  }

  .grupo-texto {
    font-weight: 300;
    font-size: 1rem;
    line-height: 1.75;
    text-transform: none;
    color: var(--texto-claro);
    max-width: 46ch;
  }

  /* Dos columnas y renglones sueltos: comprimidos se leían como un
     bloque de texto en lugar de seis cosas distintas */
  .items {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1.15rem 2.5rem;
  }

  .items li {
    position: relative;
    padding-left: 1.6rem;
    font-weight: 300;
    font-size: 1rem;
    text-transform: none;
    color: var(--texto-claro);
    line-height: 1.6;
  }

  .items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 10px;
    height: 1.5px;
    background: #a87cff;
  }

  /* ── Las webs: sin tarjetas, para que se lean como un agregado ── */
  .webs .etiqueta {
    margin-bottom: 1.1rem;
  }

  .webs-titulo {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--violeta-900);
    margin-bottom: clamp(2rem, 5vw, 3rem);
    text-wrap: balance;
  }

  .webs-grilla {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .web {
    padding-top: clamp(1.2rem, 3vw, 1.6rem);
    border-top: 2px solid var(--violeta-900);
  }

  .web h4 {
    font-size: clamp(1.15rem, 2.6vw, 1.4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--violeta-900);
    margin-bottom: 0.8rem;
  }

  .webs-pie {
    margin-top: clamp(2.2rem, 5vw, 3rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.4rem;
  }

  /* Sobre fondo claro el botón de línea necesita su propio contorno */
  .boton-linea-oscura {
    background: transparent;
    color: var(--violeta-900);
    border: 1.5px solid var(--violeta-900);
  }

  .boton-linea-oscura:hover {
    background: var(--violeta-900);
    color: var(--blanco);
  }

  .webs-nota {
    font-size: 0.9rem;
    font-weight: 300;
    color: var(--texto-medio);
  }

  @media (min-width: 880px) {
    .principal {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: start;
    }

    .principal-detalle {
      grid-template-columns: 1fr;
    }

    /* El botón cruza las dos columnas, al pie de todo */
    .principal-pie {
      grid-column: 1 / -1;
    }

    .webs-grilla {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
