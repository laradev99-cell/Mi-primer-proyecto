---
const pasos = [
  {
    n: '01',
    titulo: 'Primero entendemos, después publicamos',
    texto:
      'Analizamos tu marca y tu público antes de subir nada. De ahí sale un plan a 3 meses.',
  },
  {
    n: '02',
    titulo: 'Nunca más te quedás sin qué grabar',
    texto:
      'Armamos tu Kit de Grabación: qué grabar y cómo hacerlo con el celular. Cada mes te decimos qué toca.',
  },
  {
    n: '03',
    titulo: 'Siempre las mismas personas en tu marca',
    texto:
      'Un equipo asignado que se aprende tu marca de memoria: social media, community, diseño y edición.',
  },
  {
    n: '04',
    titulo: 'Programamos lo que tu negocio necesita',
    texto:
      'Desde una tienda lista para vender hasta un sistema a medida, con desarrolladores propios.',
  },
];
---

<section class="seccion oscura grano proceso">
  <div class="orbe orbe-proceso"></div>

  <div class="contenedor grilla">
    <div class="columna-fija">
      <p class="etiqueta" data-revelar>Cómo trabajamos</p>
      <h2 class="titulo" data-revelar style="--retraso: 80ms">
        Cuatro cosas<br />que no negociamos
      </h2>
    </div>

    <ol class="pasos">
      {
        pasos.map((p, i) => (
          <li class="paso" data-revelar style={`--retraso: ${i * 90}ms`}>
            <span class="numero" aria-hidden="true">
              {p.n}
            </span>
            <div>
              <h3 class="subtitulo">{p.titulo}</h3>
              <p class="cuerpo">{p.texto}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .proceso {
    overflow: hidden;
  }

  .orbe-proceso {
    width: min(60vw, 700px);
    aspect-ratio: 1;
    top: 12%;
    left: -22%;
    background: radial-gradient(circle, #6b2fd6 0%, transparent 70%);
    opacity: 0.55;
  }

  .grilla {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(3rem, 8vw, 5rem);
  }

  .pasos {
    list-style: none;
    display: grid;
  }

  .paso {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.2rem, 3vw, 2.4rem);
    padding-block: clamp(2rem, 4vw, 2.6rem);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .paso:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .numero {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--acento);
    padding-top: 0.45em;
  }

  .paso h3 {
    margin-bottom: 0.7rem;
    max-width: 20ch;
  }

  @media (min-width: 900px) {
    .grilla {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: clamp(3rem, 6vw, 6rem);
    }

    /* La columna izquierda queda quieta mientras pasan los pasos */
    .columna-fija {
      position: sticky;
      top: clamp(4rem, 12vh, 8rem);
      align-self: start;
    }
  }

  .columna-fija .etiqueta {
    margin-bottom: 1.4rem;
  }
</style>
