---
import Layout from '../layouts/Layout.astro';
import Pie from '../components/Pie.astro';
import { precios } from '../data/precios.js';
import { whatsapp, mensajes } from '../data/site.js';

const pesos = (n) =>
  new Intl.NumberFormat('es-AR', {
    style: 'currency',
    currency: 'ARS',
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  }).format(n);

// Desarrollo a medida ya no vive acá: está en /webs, adonde lleva el
// botón de la sección de páginas web.
const { analisisEstrategia, manejoRedes, tiendaOnline, respuestasAutomaticas, condiciones, loQueNecesitamos } = precios;
---

<Layout
  titulo="Tu propuesta"
  descripcion="Propuesta de trabajo de Naimid.Agency"
  noindex={true}
>
  <!-- ─── PORTADA ─── -->
  <header class="portada oscura grano" id="contenido">
    <div class="orbe orbe-portada"></div>
    <div class="contenedor interior">
      <p class="etiqueta" data-revelar>Naimid.Agency</p>
      <h1 class="display" data-revelar style="--retraso: 90ms">Tu propuesta</h1>
      <p class="bajada" data-revelar style="--retraso: 180ms">
        Todo lo que hablamos, ordenado. Si algo no te cierra, escribime y lo
        vemos.
      </p>
    </div>
  </header>

  <!-- ─── PASO 1 ─── -->
  <section class="seccion clara">
    <div class="contenedor">
      <p class="etiqueta" data-revelar>Paso 01</p>
      <h2 class="titulo" data-revelar style="--retraso: 70ms">
        Análisis y estrategia
      </h2>
      <p class="cuerpo bajo-titulo" data-revelar style="--retraso: 120ms">
        {analisisEstrategia.bajada}
      </p>

      <div class="dos-columnas">
        <ul class="lista-check" data-revelar>
          {analisisEstrategia.incluye.map((item) => <li>{item}</li>)}
        </ul>

        <aside class="caja-precio" data-revelar style="--retraso: 120ms">
          <p class="precio">{pesos(analisisEstrategia.precio)}</p>
          <p class="nota">{analisisEstrategia.frecuencia}</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- ─── PASO 2 ─── -->
  <section class="seccion lavanda">
    <div class="contenedor">
      <p class="etiqueta" data-revelar>Paso 02</p>
      <h2 class="titulo" data-revelar style="--retraso: 70ms">
        Manejo de redes
      </h2>
      <p class="cuerpo bajo-titulo" data-revelar style="--retraso: 120ms">
        {manejoRedes.bajada}
      </p>

      <div class="incluye-todos" data-revelar>
        <p class="incluye-titulo">Los tres planes incluyen</p>
        <ul class="lista-check dos-col">
          {manejoRedes.incluye.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      {
        manejoRedes.lanzamiento && (
          <p class="lanzamiento" data-revelar>{manejoRedes.lanzamiento}</p>
        )
      }

      <div class="planes">
        {
          manejoRedes.planes.map((plan, i) => (
            <article class="plan" data-revelar style={`--retraso: ${i * 90}ms`}>
              <p class="plan-nombre">{plan.nombre}</p>
              <p class="plan-volumen">{plan.descripcion}</p>
              <p class="plan-detalle">{plan.detalles}</p>
              {plan.precioAnterior && (
                <p class="plan-precio-anterior">{pesos(plan.precioAnterior)}</p>
              )}
              <p class="plan-precio">{pesos(plan.precio)}</p>
              <p class="plan-periodo">por mes</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ─── PÁGINAS WEB ─── -->
  <section class="seccion clara">
    <div class="contenedor">
      <p class="etiqueta" data-revelar>Paso 03</p>
      <h2 class="titulo" data-revelar style="--retraso: 70ms">
        {tiendaOnline.nombre}
      </h2>
      <p class="cuerpo bajo-titulo" data-revelar style="--retraso: 120ms">
        {tiendaOnline.bajada}
      </p>

      <dl class="filas" data-revelar>
        {
          tiendaOnline.opciones.map((o) => (
            <div class="fila">
              <dt>{o.nombre}</dt>
              <dd>{pesos(o.precio)}</dd>
            </div>
          ))
        }
      </dl>

      <p class="aclaracion" data-revelar>{tiendaOnline.nota}</p>

      <!-- El catálogo entero vive en su propia página -->
      <div class="ver-mas" data-revelar>
        <p class="ver-mas-intro">¿Querés ver más opciones?</p>
        <a class="boton boton-linea-oscura" href="/webs">
          Ver todos los servicios de páginas web
          <svg class="flecha" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 8h11m0 0-4.2-4.2M13 8l-4.2 4.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <p class="ver-mas-nota">
          Landings, catálogos con pedidos por WhatsApp, desarrollo a medida y
          automatizaciones, con precios y plazos.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── RESPUESTAS CON IA ─── -->
  <section class="seccion lavanda">
    <div class="contenedor">
      <p class="etiqueta" data-revelar>Automatización</p>
      <h2 class="titulo titulo-suelto" data-revelar style="--retraso: 70ms">
        Respuestas automáticas con IA
      </h2>

      <div class="dos-columnas">
        <div data-revelar>
          {
            respuestasAutomaticas.descripcion
              .split('\n\n')
              .map((p) => <p class="cuerpo parrafo">{p}</p>)
          }
        </div>

        <aside class="caja-precio" data-revelar style="--retraso: 120ms">
          <p class="mini-etiqueta">Instalación</p>
          <p class="precio">
            {
              respuestasAutomaticas.instalacion
                ? pesos(respuestasAutomaticas.instalacion)
                : 'A definir'
            }
          </p>
          <hr />
          <p class="mini-etiqueta">Mantenimiento</p>
          <p class="precio">
            {
              respuestasAutomaticas.mantenimiento
                ? pesos(respuestasAutomaticas.mantenimiento)
                : 'A definir'
            }
          </p>
          {
            respuestasAutomaticas.aclaracion && (
              <p class="nota">{respuestasAutomaticas.aclaracion}</p>
            )
          }
        </aside>
      </div>
    </div>
  </section>

  <!-- ─── CONDICIONES ─── -->
  <section class="seccion clara">
    <div class="contenedor">
      <p class="etiqueta" data-revelar>Condiciones</p>
      <h2 class="titulo titulo-suelto" data-revelar style="--retraso: 70ms">Cómo funciona</h2>

      <dl class="condiciones">
        {
          [
            ['Pago', condiciones.pago],
            ['Duración', condiciones.duracion],
            ['Ajuste', condiciones.ajuste],
            ['Revisiones', condiciones.revisiones],
          ].map(([titulo, texto], i) => (
            <div class="condicion" data-revelar style={`--retraso: ${i * 80}ms`}>
              <dt>{titulo}</dt>
              <dd class="cuerpo">{texto}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ─── LO QUE NECESITAMOS ─── -->
  <section class="seccion lavanda">
    <div class="contenedor">
      <p class="etiqueta" data-revelar>De tu lado</p>
      <h2 class="titulo" data-revelar style="--retraso: 70ms">
        Lo que necesitamos de vos
      </h2>
      <p class="horas" data-revelar style="--retraso: 120ms">
        Unas <span class="acento">3 horas</span> por semana.
      </p>

      <ul class="lista-check" data-revelar>
        {loQueNecesitamos.items.map((item) => <li>{item}</li>)}
      </ul>

      <p class="pacto" data-revelar>{loQueNecesitamos.nota}</p>
    </div>
  </section>

  <!-- ─── CIERRE ─── -->
  <section class="seccion oscura grano cierre">
    <div class="orbe orbe-cierre"></div>
    <div class="contenedor interior">
      <h2 class="titulo" data-revelar>¿Arrancamos?</h2>
      <p class="cuerpo" data-revelar style="--retraso: 90ms">
        Escribime y coordinamos la fecha de inicio.
      </p>
      <a
        class="boton boton-acento"
        href={whatsapp(mensajes.arrancar)}
        target="_blank"
        rel="noopener noreferrer"
        data-revelar
        style="--retraso: 160ms"
      >
        Quiero arrancar
        <svg class="flecha" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 8h11m0 0-4.2-4.2M13 8l-4.2 4.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <p class="duda" data-revelar style="--retraso: 220ms">
        ¿Alguna duda antes?{' '}
        <a
          class="enlace"
          href={whatsapp(mensajes.propuesta)}
          target="_blank"
          rel="noopener noreferrer">Escribime.</a
        >
      </p>
    </div>
  </section>

  <Pie />
</Layout>

<style>
  /* ── Portada ── */
  .portada {
    position: relative;
    overflow: hidden;
    padding-block: clamp(6rem, 18vw, 11rem) clamp(4rem, 12vw, 7rem);
  }

  .orbe-portada {
    width: min(60vw, 640px);
    aspect-ratio: 1;
    top: -25%;
    right: -15%;
    background: radial-gradient(circle, #6b2fd6 0%, transparent 68%);
    opacity: 0.8;
  }

  .interior {
    position: relative;
    z-index: 1;
  }

  .portada .etiqueta {
    color: var(--violeta-400);
    margin-bottom: clamp(1.2rem, 3vw, 1.8rem);
  }

  .portada h1 {
    margin-bottom: clamp(1.2rem, 3vw, 1.6rem);
  }

  /* ── Encabezados de sección ── */
  .etiqueta {
    margin-bottom: 1.1rem;
  }

  .bajo-titulo {
    margin-top: 1rem;
    margin-bottom: clamp(2.5rem, 6vw, 3.5rem);
    max-width: 46ch;
  }

  /* Título sin bajada: necesita su propio aire antes del contenido */
  .titulo-suelto {
    margin-bottom: clamp(2.5rem, 6vw, 3.5rem);
  }

  /* ── Listas con check ── */
  .lista-check {
    list-style: none;
    display: grid;
    gap: 0.85rem;
  }

  .lista-check.dos-col {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 0.7rem 2rem;
  }

  .lista-check li {
    position: relative;
    padding-left: 1.9rem;
    font-weight: 300;
    color: var(--texto-medio);
    line-height: 1.6;
  }

  .lista-check li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid var(--acento);
  }

  /* ── Caja de precio ── */
  .dos-columnas {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: start;
  }

  @media (min-width: 860px) {
    .dos-columnas {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    }
  }

  /* Violeta claro con borde, no el violeta-900 que leía como negro.
     El precio se destaca por tamaño, no por invertir el fondo. */
  .caja-precio {
    background: var(--violeta-100);
    border: 1px solid var(--violeta-200);
    border-radius: var(--radio);
    padding: clamp(1.8rem, 4vw, 2.4rem);
  }

  /* Sobre lavanda el violeta claro desaparece: ahí la caja va blanca */
  .lavanda .caja-precio {
    background: var(--blanco);
  }

  .caja-precio hr {
    border: none;
    border-top: 1px solid var(--violeta-200);
    margin-block: 1.4rem;
  }

  .precio {
    font-size: clamp(2rem, 5.5vw, 2.9rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--violeta-900);
    font-variant-numeric: tabular-nums;
  }

  .mini-etiqueta {
    font-size: var(--micro);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--violeta-600);
    margin-bottom: 0.5rem;
  }

  .nota {
    margin-top: 0.8rem;
    font-size: 0.88rem;
    font-weight: 300;
    line-height: 1.55;
    color: var(--texto-medio);
  }

  /* ── Incluye todos ── */
  .incluye-todos {
    background: var(--blanco);
    border-radius: var(--radio);
    padding: clamp(1.6rem, 4vw, 2.4rem);
    margin-bottom: clamp(1.5rem, 4vw, 2rem);
  }

  .incluye-titulo {
    font-size: var(--micro);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--violeta-600);
    margin-bottom: 1.3rem;
  }

  /* ── Planes ── */
  .planes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: clamp(0.85rem, 2vw, 1.1rem);
  }

  .plan {
    background: var(--blanco);
    border: 1px solid var(--violeta-200);
    border-radius: var(--radio);
    padding: clamp(1.6rem, 4vw, 2.2rem);
    transition: transform var(--transicion), box-shadow var(--transicion);
  }

  .plan:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 48px -30px rgba(45, 10, 107, 0.5);
  }

  /* Discreto a propósito: es una promo, no un cartel de oferta */
  .lanzamiento {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--acento);
    margin-bottom: clamp(1.2rem, 3vw, 1.6rem);
  }

  .plan-nombre {
    font-size: var(--micro);
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--violeta-600);
    margin-bottom: 1.2rem;
  }

  .plan-precio-anterior {
    font-size: 1rem;
    font-weight: 500;
    color: var(--texto-medio);
    text-decoration: line-through;
    text-decoration-color: var(--violeta-200);
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.2rem;
  }

  .plan-volumen {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--violeta-900);
    line-height: 1.4;
  }

  .plan-detalle {
    font-size: 0.88rem;
    font-weight: 300;
    color: var(--texto-medio);
    margin-bottom: 1.6rem;
  }

  .plan-precio {
    font-size: clamp(1.6rem, 4vw, 2.05rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--violeta-900);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .plan-periodo {
    font-size: 0.85rem;
    font-weight: 300;
    color: var(--texto-medio);
  }

  /* ── Filas de precios ── */
  .filas {
    border-top: 1px solid var(--violeta-200);
  }

  .fila {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    padding-block: clamp(1.1rem, 3vw, 1.5rem);
    border-bottom: 1px solid var(--violeta-200);
  }

  .fila dt {
    font-weight: 400;
    color: var(--violeta-900);
  }

  .fila dd {
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--violeta-600);
    font-size: 1.05rem;
    font-variant-numeric: tabular-nums;
  }

  .aclaracion {
    margin-top: 1.4rem;
    font-size: 0.88rem;
    font-weight: 300;
    color: var(--texto-medio);
    max-width: 60ch;
  }

  .ver-mas {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-top: clamp(2rem, 5vw, 2.6rem);
    border-top: 1px solid var(--violeta-200);
  }

  .ver-mas-intro {
    font-size: clamp(1.15rem, 2.6vw, 1.4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--violeta-900);
    margin-bottom: 1.3rem;
  }

  .boton-linea-oscura {
    background: transparent;
    color: var(--violeta-900);
    border: 1.5px solid var(--violeta-900);
  }

  .boton-linea-oscura:hover {
    background: var(--violeta-900);
    color: var(--blanco);
  }

  .ver-mas-nota {
    margin-top: 1.1rem;
    font-size: 0.9rem;
    font-weight: 300;
    color: var(--texto-medio);
    max-width: 52ch;
  }

  .parrafo {
    margin-bottom: 1.2rem;
  }

  /* ── Condiciones ──
     Lista de definiciones con reglas finas: es un documento
     contractual, se lee como tal. */
  .condiciones {
    margin-top: clamp(2rem, 5vw, 3rem);
    border-top: 2px solid var(--violeta-900);
  }

  .condicion {
    display: grid;
    gap: 0.5rem 3rem;
    padding-block: clamp(1.3rem, 3.5vw, 1.8rem);
    border-bottom: 1px solid var(--violeta-200);
  }

  .condicion dt {
    font-size: var(--micro);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--violeta-600);
    padding-top: 0.35em;
  }

  .condicion dd {
    max-width: 58ch;
  }

  @media (min-width: 760px) {
    .condicion {
      grid-template-columns: minmax(0, 0.28fr) minmax(0, 1fr);
    }
  }

  /* ── Lo que necesitamos ── */
  .horas {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 200;
    letter-spacing: -0.025em;
    color: var(--violeta-900);
    margin-block: 1.2rem clamp(2rem, 5vw, 2.8rem);
  }

  .horas .acento {
    font-weight: 700;
  }

  .pacto {
    margin-top: clamp(2rem, 5vw, 2.8rem);
    padding: clamp(1.4rem, 4vw, 1.9rem);
    background: var(--violeta-100);
    border-radius: var(--radio);
    font-weight: 400;
    color: var(--violeta-900);
    max-width: 52ch;
  }

  /* ── Cierre ── */
  .cierre {
    overflow: hidden;
    background: linear-gradient(180deg, var(--tinta) 0%, #240a54 100%);
  }

  .orbe-cierre {
    width: min(70vw, 740px);
    aspect-ratio: 1;
    bottom: -35%;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle, #a87cff 0%, transparent 65%);
    opacity: 0.3;
  }

  .cierre .interior {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cierre .cuerpo {
    margin-bottom: 2rem;
  }

  .duda {
    margin-top: 1.6rem;
    font-size: 0.92rem;
    font-weight: 300;
    color: var(--texto-claro);
  }

  .duda .enlace {
    color: var(--blanco);
    font-weight: 500;
  }
</style>
