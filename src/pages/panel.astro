---
/*
 * EL PANEL DE LARA — cascarón de compilación, no una página del
 * sitio.
 *
 * El panel real no vive acá ni en naimid.com.ar: se publica como
 * un Artifact privado de Claude, con acceso restringido a Lara y
 * los datos guardados en su base propia (ver src/panel/estado.js).
 * Esta página de Astro solo existe para que `astro build` genere
 * el CSS y el JS ya empaquetados, que después `inline.cjs` junta
 * en un solo archivo HTML listo para publicar. Ver PANEL.md.
 *
 * Si alguien entra a /panel en el sitio en vivo, ve esta misma
 * pantalla pero sin datos: no tiene forma de conectarse a la base
 * (esa conexión solo existe dentro del visor de Claude), así que
 * muestra el aviso de "no se pudo conectar" y nada más. No pasa
 * nada si queda así — no se linkea desde ningún lado del sitio.
 */
import Layout from '../layouts/Layout.astro';
import '../styles/panel.css';
---

<Layout
  titulo="Panel"
  descripcion="El panel interno de Naimid.Agency."
  noindex={true}
  clase="panel-body"
  colorTema="#f6f5f9"
>
  <div id="panel">
    <!-- Lo que se ve mientras carga el JavaScript. Dura un parpadeo. -->
    <p class="cargando">Abriendo tu panel…</p>
  </div>

  <script>
    import '../panel/app.js';
  </script>
</Layout>

<style>
  .cargando {
    display: grid;
    place-items: center;
    height: 100dvh;
    color: #7d7391;
    font-size: 0.9rem;
  }
</style>
