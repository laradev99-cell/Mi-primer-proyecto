---
import Layout from '../layouts/Layout.astro';

const whatsappLink = "https://wa.me/message/RVXNEXMKBJIYC1";
const calLink = "https://cal.com/placeholder"; // Reemplazar con tu link real
---

<Layout title="Hacemos que tu marca se venda sola">
  <style>
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 var(--spacing-md);
    }

    /* Hero */
    .hero {
      background: linear-gradient(135deg, var(--color-lightest) 0%, var(--color-light) 100%);
      padding: var(--spacing-2xl) var(--spacing-md);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .hero-content {
      max-width: 800px;
      margin: 0 auto;
    }

    .hero h1 {
      color: var(--color-darkest);
      margin-bottom: var(--spacing-lg);
      font-weight: 900;
    }

    .hero p {
      font-size: 1.3rem;
      color: var(--color-dark);
      margin-bottom: var(--spacing-2xl);
      font-weight: 300;
    }

    /* Secciones */
    .section {
      padding: var(--spacing-2xl) var(--spacing-md);
      border-bottom: 1px solid var(--color-lightest);
    }

    .section-content {
      max-width: 1000px;
      margin: 0 auto;
    }

    .section h2 {
      text-align: center;
      color: var(--color-darkest);
      margin-bottom: var(--spacing-2xl);
    }

    /* El problema */
    .problem-intro {
      text-align: center;
      margin-bottom: var(--spacing-2xl);
      font-size: 1.1rem;
      color: var(--color-dark);
    }

    .problems-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--spacing-xl);
      margin-bottom: var(--spacing-xl);
    }

    .problem-block h3 {
      color: var(--color-dark);
      margin-bottom: var(--spacing-md);
    }

    .problem-block p {
      color: var(--color-dark);
      font-weight: 300;
      line-height: 1.8;
    }

    .problem-closing {
      text-align: center;
      font-size: 1.1rem;
      color: var(--color-dark);
      margin-top: var(--spacing-2xl);
      font-weight: 300;
      line-height: 1.8;
    }

    /* Cómo trabajamos */
    .how-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--spacing-lg);
    }

    .how-block h3 {
      color: var(--color-dark);
      margin-bottom: var(--spacing-md);
      font-weight: 600;
    }

    .how-block p {
      color: var(--color-dark);
      font-weight: 300;
      line-height: 1.8;
    }

    /* Servicios */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: var(--spacing-lg);
    }

    .service-card h3 {
      color: var(--color-dark);
      margin-bottom: var(--spacing-md);
      font-weight: 600;
    }

    .service-card p {
      color: var(--color-dark);
      font-weight: 300;
      line-height: 1.8;
      font-size: 0.95rem;
    }

    /* Cómo somos */
    .about-content {
      max-width: 700px;
      margin: 0 auto;
      text-align: center;
    }

    .about-content h2 {
      margin-bottom: var(--spacing-lg);
    }

    .about-content p {
      font-size: 1.1rem;
      color: var(--color-dark);
      font-weight: 300;
      line-height: 1.9;
      margin-bottom: var(--spacing-lg);
    }

    /* Calendario / CTA */
    .cta-section {
      background-color: var(--color-lightest);
      padding: var(--spacing-2xl) var(--spacing-md);
    }

    .cta-content {
      max-width: 800px;
      margin: 0 auto;
    }

    .cta-content h2 {
      text-align: center;
      margin-bottom: var(--spacing-lg);
    }

    .cta-intro {
      text-align: center;
      font-size: 1rem;
      color: var(--color-dark);
      margin-bottom: var(--spacing-2xl);
      font-weight: 300;
      line-height: 1.8;
    }

    .calendar-placeholder {
      background: white;
      border: 2px dashed var(--color-medium);
      border-radius: 0.5rem;
      padding: var(--spacing-2xl);
      text-align: center;
      margin-bottom: var(--spacing-xl);
      color: var(--color-dark);
    }

    .calendar-placeholder p {
      margin: 0;
      font-weight: 300;
    }

    .whatsapp-secondary {
      text-align: center;
      font-size: 0.9rem;
    }

    .whatsapp-secondary a {
      color: var(--color-dark);
      font-weight: 500;
      text-decoration: underline;
    }

    .whatsapp-secondary a:hover {
      color: var(--color-darkest);
    }

    /* Footer */
    footer {
      background-color: var(--color-darkest);
      color: white;
      padding: var(--spacing-xl) var(--spacing-md);
      text-align: center;
    }

    footer p {
      margin-bottom: var(--spacing-sm);
      font-weight: 300;
    }

    footer a {
      color: var(--color-light);
    }

    footer a:hover {
      color: white;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .hero {
        padding: var(--spacing-xl) var(--spacing-md);
        min-height: auto;
      }

      .hero h1 {
        font-size: 2.5rem;
      }

      .hero p {
        font-size: 1.1rem;
      }

      .section {
        padding: var(--spacing-xl) var(--spacing-md);
      }

      .section h2 {
        font-size: 2rem;
      }
    }

    @media (max-width: 480px) {
      .hero h1 {
        font-size: 1.8rem;
      }

      .hero p {
        font-size: 1rem;
      }

      h2 {
        font-size: 1.8rem;
      }

      h3 {
        font-size: 1.2rem;
      }
    }
  </style>

  <!-- HERO -->
  <section class="hero" id="hero">
    <div class="hero-content">
      <h1>Hacemos que tu marca se venda sola</h1>
      <p>Estrategia, contenido y desarrollo web para marcas que venden online. Todo con el mismo equipo.</p>
      <a href="#calendar" class="btn btn-primary">Reservar un diagnóstico gratis</a>
    </div>
  </section>

  <!-- EL PROBLEMA -->
  <section class="section">
    <div class="section-content">
      <h2>Lo que vemos todos los días</h2>
      <p class="problem-intro">Trabajamos con marcas que venden online, y casi todas llegan con el mismo cuadro.</p>

      <div class="problems-grid">
        <div class="problem-block">
          <h3>Publican sin saber si sirve</h3>
          <p>Se sube algo el lunes porque hay que subir algo. Sin plan, sin pilares, sin saber a quién le hablan.</p>
        </div>
        <div class="problem-block">
          <h3>No tienen qué grabar</h3>
          <p>No hay fotos, no hay videos, no hay tiempo. Entonces el contenido se hace con lo que hay, y lo que hay es siempre lo mismo.</p>
        </div>
        <div class="problem-block">
          <h3>No saben qué les trae plata</h3>
          <p>Reciben reportes con alcance, likes y seguidores nuevos, pero nadie les dice cuántos pesos entraron por Instagram.</p>
        </div>
      </div>

      <p class="problem-closing">Si algo de esto te suena, no es porque hiciste las cosas mal. Es porque estabas haciendo dos trabajos a la vez.</p>
    </div>
  </section>

  <!-- CÓMO TRABAJAMOS -->
  <section class="section">
    <div class="section-content">
      <h2>Cómo trabajamos</h2>

      <div class="how-grid">
        <div class="how-block">
          <h3>Primero entendemos, después publicamos</h3>
          <p>Antes de subir una sola pieza analizamos tu marca, tu público y lo que veniste haciendo. De ahí sale un plan a 3 meses. Nunca vas a recibir contenido improvisado.</p>
        </div>
        <div class="how-block">
          <h3>Nunca más te quedás sin qué grabar</h3>
          <p>Todos los meses te mandamos el Kit de Grabación: qué grabar, cómo grabarlo con el celular y cuándo mandarlo. Vos grabás, nosotros nos encargamos del resto.</p>
        </div>
        <div class="how-block">
          <h3>Siempre las mismas personas en tu marca</h3>
          <p>Tenés un equipo asignado: quien piensa la estrategia, quien edita, quien diseña y quien publica. Con el tiempo se aprenden tu marca de memoria, y eso se nota en el contenido.</p>
        </div>
        <div class="how-block">
          <h3>Programamos lo que tu negocio necesita</h3>
          <p>Desde una tienda lista para vender hasta un sistema hecho a medida. Tenemos desarrolladores propios, así que la web y el contenido salen del mismo equipo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="section">
    <div class="section-content">
      <h2>Qué hacemos</h2>

      <div class="services-grid">
        <div class="service-card">
          <h3>Análisis y estrategia</h3>
          <p>Entendemos tu marca, tu público y tu competencia. De ahí sale el plan que guía todo el trabajo.</p>
        </div>
        <div class="service-card">
          <h3>Manejo de redes sociales</h3>
          <p>Ideas, diseño, edición, textos y publicación. Contenido constante en Instagram y Facebook, con reporte mensual.</p>
        </div>
        <div class="service-card">
          <h3>Tienda online</h3>
          <p>Armamos tu tienda en Tienda Nube o Shopify, o mejoramos la que ya tenés.</p>
        </div>
        <div class="service-card">
          <h3>Desarrollo a medida</h3>
          <p>Webs, tiendas y sistemas programados desde cero, con código propio. Sin plantillas y sin las limitaciones de una plataforma.</p>
        </div>
        <div class="service-card">
          <h3>Respuestas automáticas con IA</h3>
          <p>Un asistente que conoce tu negocio y responde precios, stock y envíos en Instagram y WhatsApp las 24 horas.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CÓMO SOMOS -->
  <section class="section">
    <div class="section-content">
      <div class="about-content">
        <h2>Cómo somos para trabajar</h2>
        <p>Te vamos a decir lo que pensamos, aunque no sea lo que querías escuchar. Si creemos que tu negocio necesita resolver otra cosa antes que las redes, te lo vamos a decir.</p>
        <p>No prometemos ventas en 30 días. Preferimos darte plazos reales y cumplirlos.</p>
        <p>Y todo lo que hacemos te lo explicamos: vas a entender siempre por qué publicamos lo que publicamos.</p>
      </div>
    </div>
  </section>

  <!-- CTA CON CALENDARIO -->
  <section class="cta-section" id="calendar">
    <div class="cta-content">
      <h2>Empecemos por una charla</h2>
      <p class="cta-intro">Son 30 minutos y son para escucharte: qué vendés, cómo venís, qué te está costando. Con eso te digo qué veo y qué haría con tu marca. Salgas o no trabajando con nosotros, te llevás el diagnóstico.</p>

      <div class="calendar-placeholder">
        <p>📅 Calendario embebido de Cal.com</p>
        <p style="font-size: 0.9rem; margin-top: var(--spacing-sm);">Reemplazar CAL_LINK con tu link real de cal.com</p>
      </div>

      <div class="whatsapp-secondary">
        <p>¿Preferís escribirme antes? <a href={whatsappLink} target="_blank" rel="noopener noreferrer">Mandame un mensaje.</a></p>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <p><strong>Naimid.Agencÿ</strong></p>
    <p>
      Instagram: <a href="https://instagram.com/naimid.agency" target="_blank" rel="noopener noreferrer">@naimid.agency</a>
    </p>
    <p>
      TikTok: <a href="https://tiktok.com/@naimid.agency" target="_blank" rel="noopener noreferrer">@naimid.agency</a>
    </p>
    <p>
      <a href={whatsappLink} target="_blank" rel="noopener noreferrer">Escribime por WhatsApp</a>
    </p>
  </footer>
</Layout>
